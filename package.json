{
  "name": "pi-crucible",
  "version": "0.1.0",
  "private": true,
  "description": "spec → implement → review → revise → PR loop for GitHub issues, as a pi-subagents workflow",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seandavi/pi-crucible.git"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/crucible.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "extensions",
    "skills",
    "src",
    "workflows",
    "docs",
    "schema",
    "examples"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "check": "node scripts/check-workflow.mjs",
    "schema": "node scripts/write-schema.ts"
  },
  "dependencies": {
    "pi-subagents": "^0.80.0",
    "yaml": "^2.8.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "typebox": "^1.4.3"
  }
}
